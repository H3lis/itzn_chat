# 환경변수(비밀 포함)
.env

# 임시 인덱스 및 캐시만 무시 (운영 색인 ragdata/index 는 추적)
ragdata/cache/
ragdata/index_new/
ragdata/index_prev/
ragdata/index_old*/

# 원복용 스냅샷(색인 69MB · .env 유일본). 절대 커밋하지 않는다 — .env 가 들어 있다.
# 복원 절차는 _backup/RESTORE.md 참조.
_backup/

# 런타임 생성물
runtime/evidence/*
!runtime/evidence/.gitkeep
runtime/rag_outputs/
runtime/rag_cache/
runtime/reports/*
!runtime/reports/.gitkeep

# vendored ragcore 의 데이터 하위폴더가 실수로 생성될 경우
ragcore/rag3/index/
ragcore/rag3/cache/
ragcore/rag3/outputs/

# 파이썬 캐시/테스트
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
