@echo off
chcp 65001 > nul
echo ==============================================================================
echo [itzn_chat] GitHub 원격 저장소로 푸시 (Push)
echo ==============================================================================
echo.

set "GIT_EXE=%~dp0.tools\git\cmd\git.exe"
if not exist "%GIT_EXE%" (
    set "GIT_EXE=git"
)

echo 최신 커밋을 origin main 으로 푸시합니다...
"%GIT_EXE%" push origin main

if %ERRORLEVEL% equ 0 (
    echo.
    echo ==============================================================================
    echo [성공] GitHub(https://github.com/H3lis/itzn_chat)에 성공적으로 푸시되었습니다!
    echo ==============================================================================
) else (
    echo.
    echo ==============================================================================
    echo [안내] GitHub 로그인 창 또는 토큰(Personal Access Token) 입력이 필요할 수 있습니다.
    echo ==============================================================================
)

pause
